/* PRODUCTION BASELINE — captured 2026-09-08 from the Firebase console,
 * project newt-90ca4, Firestore (default) database, Rules tab.
 *
 * This is the ruleset that was live BEFORE the integration namespace was added.
 * It exists as a rollback: if the merged rules cause a problem, paste this back
 * into the console and publish.
 *
 * Do not edit this file. It is a record, not a source.
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /dashboard/satya {
      allow read, write: if request.auth != null;
    }
  }
}

/* Observation, recorded but NOT changed as part of the integration work:
 *
 * `request.auth != null` allows ANY authenticated user of this Firebase project
 * to read and write the whole dashboard document, not only its owner. For a
 * single-account personal project that is a small risk — accounts only exist if
 * the owner creates them — but the stricter form would be:
 *
 *   allow read, write: if request.auth != null && request.auth.uid == '<owner uid>';
 *
 * Tightening it is a separate decision with its own blast radius (get the uid
 * wrong and the dashboard stops loading), so it was left exactly as found.
 */
